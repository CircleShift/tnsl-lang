struct Scope {
	~uint8 name,
	~Module mod,
	~CompBuf cb,
	
	~Scope parent,

	utils.Vector
		vars
}

/; method Scope
	/; init (~Module mod, ~CompBuf cb, ~uint8 name)
		self.name = utils.strcpy(name)
		self.mod = mod
		self.cb = cb

		Var v
		self.vars.init(len v)
	;/
	
	/; _compile_statements (~parse.Node up, int o)
	;/

	/; end
		_delete(self.name)

		~Var v
		/; loop (int i = 0; i < self.vars.count) [i++]
			v = self.vars.get(i)
			v`.end()
		;/
	;/
;/

